# =====================================================================
# MSAez v1.0.30 docker-compose 환경변수
#
# 사용:  cp .env.example .env   후 아래 값을 채운다.
# docker compose 가 같은 디렉토리의 .env 를 읽어 docker-compose.yml 의
# ${VAR} 를 치환한다. .env 는 .gitignore 대상이라 git 에 추적되지 않는다
#   → 비밀값이 커밋되지 않고, docker-compose.yml 은 수정되지 않아 pull 충돌도 없다.
#
# (data-gateway 게이트웨이는 별도의 data-gateway/.env 를 쓴다 — README §4)
# =====================================================================

# PostgreSQL 비밀번호 — 임의의 강한 값.
# postgres / backend 2종 / data-gateway(data-gateway/.env) 가 모두 공유한다.
DB_PASSWORD=

# 브라우저가 접근하는 호스트 IP 또는 도메인 (예: 34.64.202.245). 로컬은 localhost.
VM_IP=

# Gitea Personal Access Token — v1.0.29 에서 쓰던 값 그대로.
GITEA_PERSONAL_ACCESS_TOKEN=

# LLM API Key — OpenAI 직접 사용 시 OpenAI Key / P-GPT 사용 시 P-GPT Key.
OPENAI_API_KEY=

# 임베딩용 실제 OpenAI Key — P-GPT 사용 시에도 임베딩은 OpenAI 라 필수.
OPENAI_EMBEDDING_API_KEY=

# Google AI (Gemini) API Key — eventstorming-generator 에서 Gemini 사용 시.
GOOGLE_API_KEY=

# (선택) P-GPT 사용 시에만: 엔드포인트 URL.
# 설정하려면 아래 주석을 해제하고, docker-compose.yml 의 OPENAI_BASE_URL 줄도 주석 해제.
#   개발계: http://taigpt.posco.net/gpgpta01-gpt/v1
#   운영계: http://aigpt.posco.net/gpgpta01-gpt/v1
# OPENAI_BASE_URL=

# msaez-data-gateway 환경변수 예시. 복사해서 .env 로 사용 (cp .env.example .env).

# ── 게이트웨이 ──────────────────────────────────────────────
GATEWAY_PORT=5757
DB_NAME=mydb

# ── PostgreSQL — docker-compose 의 postgres 서비스와 일치시킬 것 ──
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=msaez
POSTGRES_USER=msaez
POSTGRES_PASSWORD=

# ── JWT 서명 시크릿 — 임의의 긴 랜덤 문자열 ──
JWT_SECRET=change-me

# ── Gitea OAuth — AceBase 가 쓰던 값을 그대로 재사용 ──
PROVIDER=gitea
CLIENT_ID=
CLIENT_SECRET=
GIT=localhost:3000
PROTOCOL=http
